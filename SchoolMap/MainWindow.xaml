<Window x:Class="SchoolMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SchoolMap.ViewModels"
        xmlns:conv="clr-namespace:SchoolMap.Converters"
        mc:Ignorable="d"
        Title="🏫 Iskola Térkép – A Épület"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SurfaceBrush}"
        MinWidth="1200" MinHeight="700">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <!-- Fő elrendezés: felső sáv + tartalom -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- FEJLÉC – Kiosk stílusú felső sáv                            -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logó és cím -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏫" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Iskola Térkép" Style="{StaticResource TitleText}" />
                        <TextBlock Text="'A' Épület – Interaktív Térkép"
                                   FontSize="13" Foreground="{StaticResource AccentLightBrush}"
                                   Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Keresőmező -->
                <Border Grid.Column="1" MaxWidth="500" Margin="40,0">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="🔍 Keresés terem, labor, iroda..." />
                </Border>

                <!-- Szűrők törlése gomb -->
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ClearFilterCommand}"
                        Content="✕  Szűrők törlése"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- TARTALOM – bal panel (térkép) + jobb panel (info/lista)      -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ====================================================== -->
            <!-- BAL OLDAL – Térkép és vezérlők                         -->
            <!-- ====================================================== -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Emeletválasztó -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍 Emelet:" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,12,0" />
                        <ItemsControl ItemsSource="{Binding Floors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FloorButton}"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Kategóriaszűrők -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Térkép Canvas -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <!-- Háttér rács minta a térkép hangulathoz -->
                        <Canvas x:Name="MapCanvas"
                                Background="#F8FAFC"
                                ClipToBounds="True" />

                        <!-- Üres állapot szöveg -->
                        <TextBlock Text="Nincs találat ezen az emeleten a megadott szűrőkkel."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding Rooms.Count, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================================== -->
            <!-- JOBB OLDAL – Információs panel                          -->
            <!-- ====================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Kiválasztott helyiség információ -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardPanel}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Bezáró gomb -->
                        <Button HorizontalAlignment="Right"
                                Content="✕" FontSize="18"
                                Command="{Binding ClearSelectionCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Cursor="Hand" Padding="4" Margin="0,0,0,4" />

                        <!-- Ikon és név -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedRoom.Icon}"
                                       FontSize="40" VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRoom.Name}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedRoomCategoryName}"
                                           FontSize="13" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Részletek -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedRoom.Description}"
                                       Style="{StaticResource BodyText}" FontSize="15"
                                       LineHeight="22" />
                        </Border>

                        <!-- Emelet info -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="📍" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="'A' Épület – "
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedRoomFloorName}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Útvonal gomb (előkészítés – későbbi fejlesztés) -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="🧭  Útvonal tervezése"
                                Margin="0,16,0,0"
                                IsEnabled="False"
                                Opacity="0.5"
                                ToolTip="Hamarosan elérhető!" />
                    </StackPanel>
                </Border>

                <!-- Nincs kiválasztás szöveg -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardPanel}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsRoomSelected, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,20">
                        <TextBlock Text="👆" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Válassz egy helyiséget!"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Kattints a térképre vagy válassz a listából."
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Helyiségek listája -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 Helyiségek"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="8,4,0,12" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Rooms}"
                                 SelectedItem="{Binding SelectedRoom}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="10" Padding="12,10"
                                            Margin="0,3" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="24" VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
